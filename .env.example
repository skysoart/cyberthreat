# Adamantine — example environment file.
# Copy to .env and edit. Every value below is already the default, so .env is
# optional: the project runs with no configuration at all.

# Database. Must match where seed.py writes, which is the repo root.
DATABASE_URL=sqlite:///./adamantine.db

# Sensor authentication. Sent by widget/adamantine-sensor.js as X-Adamantine-Key.
API_KEY=adm_live_demo

# Background correlation cadence, in seconds.
CORRELATE_INTERVAL_SECONDS=15

# Set to 1 to block all outbound HTTP. Threat feeds then read local cache only.
OFFLINE=0

# There are NO secrets in this project. No LLM keys, no third-party accounts.
# If a future change needs one, something has gone wrong.
